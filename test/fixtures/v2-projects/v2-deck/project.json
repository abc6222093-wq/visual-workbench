    {
      "id": "page_motion4",
      "name": "motion",
      "background": "#111827",
      "motion": {
        "steps": 2,
        "source": "export default async function (ctx) {\n  const title = ctx.element('el_mtitle').node;\n  const box = ctx.element('el_mbox').node;\n  const dot = ctx.element('el_mdot').node;\n  const pose = box.style.transform || '';\n  title.style.opacity = '0';\n  return {\n    async step(index) {\n      if (index === 0) {\n        await ctx.animate(title, [{ opacity: 0 }, { opacity: ctx.element('el_mtitle').base.opacity ?? 1 }], { duration: 300, fill: 'forwards' });\n        await ctx.animate(box, [{ transform: pose }, { transform: pose + ' translateX(' + ctx.element('el_mbox').base.width * 2 + 'px)' }], { duration: 300, fill: 'forwards' });\n      } else if (index === 1) {\n        const { animate } = await ctx.importModule('/vendor/anime.esm.min.js');\n        await animate(dot, { translateY: -120, backgroundColor: '#facc15', duration: 300 });\n        await ctx.timer(50);\n      }\n    },\n    async transition({ to }) { if (to) await ctx.animate(to, [{ opacity: 0 }, { opacity: 1 }], { duration: 200 }); },\n    dispose() {}\n  };\n}"
      },
