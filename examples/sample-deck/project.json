{
  "format": "visual-workbench/project",
  "formatVersion": 1,
  "id": "sample-deck",
  "name": "示例课件 · 格式演示",
  "description": "覆盖格式支持的全部动效：依次淡入、点击出现、连续推进、联动平移缩放、跨步骤移动变色、渐变遮罩、颜色混合、黑白滤镜、多边形裁切。",
  "createdAt": "2026-10-01T12:00:00.000Z",
  "updatedAt": "2026-10-01T12:00:00.000Z",
  "artboard": { "preset": "slide-16x9", "width": 1920, "height": 1080 },

  "assets": [
    {
      "id": "asset_city01",
      "kind": "image",
      "file": "assets/photo-city.png",
      "name": "城市照片",
      "width": 640,
      "height": 360,
      "pendingLayout": false,
      "addedAt": "2026-10-01T12:00:00.000Z",
      "source": { "type": "upload" }
    },
    {
      "id": "asset_logo01",
      "kind": "image",
      "file": "assets/logo.png",
      "name": "标志",
      "width": 256,
      "height": 256,
      "pendingLayout": false,
      "addedAt": "2026-10-01T12:00:00.000Z",
      "source": { "type": "library", "from": "logo.png" }
    },
    {
      "id": "asset_newpic1",
      "kind": "image",
      "file": "assets/new-photo.png",
      "name": "エイ 新拖进来的照片（待排版）",
      "width": 400,
      "height": 300,
      "pendingLayout": true,
      "addedAt": "2026-10-01T12:30:00.000Z",
      "source": { "type": "upload" }
    }
  ],

  "fonts": [
    {
      "id": "font_inter",
      "family": "Inter",
      "file": "fonts/Inter-Variable.ttf",
      "weight": "variable",
      "style": "normal",
      "license": "fonts/Inter-OFL.txt"
    }
  ],

  "pages": [
    {
      "id": "page_cover1",
      "name": "1 封面：依次淡入 / 点击出现 / 渐变遮罩",
      "background": "#0f172a",
      "elements": [
        {
          "id": "el_bgphoto",
          "type": "image",
          "name": "背景照片（渐变遮罩）",
          "x": 0, "y": 0, "width": 1920, "height": 1080, "zIndex": 0,
          "asset": "asset_city01",
          "fit": "cover",
          "opacity": 0.8,
          "effects": {
            "mask": {
              "type": "linear",
              "angle": 180,
              "stops": [
                { "offset": 0, "opacity": 1 },
                { "offset": 1, "opacity": 0 }
              ]
            }
          }
        },
        {
          "id": "el_title1",
          "type": "text",
          "name": "标题",
          "x": 160, "y": 300, "width": 1600, "height": 160, "zIndex": 10,
          "text": "视觉工作台",
          "font": "font_inter",
          "fontSize": 120,
          "fontWeight": 700,
          "lineHeight": 1.2,
          "align": "left",
          "color": "#ffffff"
        },
        {
          "id": "el_subtitle1",
          "type": "text",
          "name": "副标题",
          "x": 160, "y": 480, "width": 1600, "height": 80, "zIndex": 10,
          "text": "agent 生成 · エイ 微调 · agent 继续",
          "font": "font_inter",
          "fontSize": 48,
          "fontWeight": 400,
          "align": "left",
          "color": "#cbd5e1"
        },
        {
          "id": "el_bullet1",
          "type": "text",
          "name": "要点 1",
          "x": 160, "y": 640, "width": 1200, "height": 70, "zIndex": 10,
          "text": "① 格式稳定：每个元素有编号",
          "font": "font_inter", "fontSize": 40, "color": "#ffffff"
        },
        {
          "id": "el_bullet2",
          "type": "text",
          "name": "要点 2",
          "x": 160, "y": 730, "width": 1200, "height": 70, "zIndex": 10,
          "text": "② 动效只挂编号，只写相对变化",
          "font": "font_inter", "fontSize": 40, "color": "#ffffff"
        },
        {
          "id": "el_bullet3",
          "type": "text",
          "name": "要点 3",
          "x": 160, "y": 820, "width": 1200, "height": 70, "zIndex": 10,
          "text": "③ 位置随便挪，动效照样跑",
          "font": "font_inter", "fontSize": 40, "color": "#ffffff"
        },
        {
          "id": "el_logo1",
          "type": "image",
          "name": "标志",
          "x": 1560, "y": 80, "width": 200, "height": 200, "zIndex": 20,
          "asset": "asset_logo01",
          "fit": "contain"
        }
      ],
      "steps": [
        {
          "id": "step_cover_in",
          "name": "页面开始：标题、副标题依次淡入",
          "trigger": "auto",
          "tracks": [
            { "target": "el_title1", "delay": 0, "duration": 600, "change": { "appear": true, "y": { "by": -20 } } },
            { "target": "el_subtitle1", "delay": 300, "duration": 600, "change": { "appear": true, "y": { "by": -20 } } }
          ]
        },
        {
          "id": "step_cover_bullets",
          "name": "点击：三条要点依次淡入",
          "trigger": "click",
          "tracks": [
            { "target": "el_bullet1", "delay": 0, "duration": 400, "change": { "appear": true } },
            { "target": "el_bullet2", "delay": 250, "duration": 400, "change": { "appear": true } },
            { "target": "el_bullet3", "delay": 500, "duration": 400, "change": { "appear": true } }
          ]
        },
        {
          "id": "step_cover_mask",
          "name": "点击：背景遮罩变成上下都透、中间实",
          "trigger": "click",
          "tracks": [
            {
              "target": "el_bgphoto",
              "duration": 800,
              "change": {
                "mask": {
                  "to": {
                    "type": "linear",
                    "angle": 180,
                    "stops": [
                      { "offset": 0, "opacity": 0 },
                      { "offset": 0.5, "opacity": 1 },
                      { "offset": 1, "opacity": 0 }
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },

    {
      "id": "page_scene2",
      "name": "2 推进：联动平移缩放 / 连续推进 / 移动变色 / 混合 / 黑白",
      "background": {
        "type": "linear",
        "angle": 90,
        "stops": [
          { "offset": 0, "color": "#1e293b" },
          { "offset": 1, "color": "#0f172a" }
        ]
      },
      "elements": [
        {
          "id": "el_photo2",
          "type": "image",
          "name": "照片",
          "x": 200, "y": 200, "width": 640, "height": 360, "zIndex": 1,
          "asset": "asset_city01",
          "fit": "cover",
          "effects": { "filters": { "grayscale": 0 } }
        },
        {
          "id": "el_tint2",
          "type": "shape",
          "name": "颜色混合层（multiply）",
          "x": 200, "y": 200, "width": 640, "height": 360, "zIndex": 2,
          "shape": "rect",
          "fill": "#f59e0b",
          "stroke": null,
          "effects": { "blend": "multiply" }
        },
        {
          "id": "el_card2a",
          "type": "shape",
          "name": "卡片 A",
          "x": 1000, "y": 200, "width": 360, "height": 240, "zIndex": 3,
          "shape": "rect",
          "fill": "#334155",
          "stroke": { "color": "#94a3b8", "width": 2 },
          "cornerRadius": 24
        },
        {
          "id": "el_card2b",
          "type": "shape",
          "name": "卡片 B",
          "x": 1400, "y": 200, "width": 360, "height": 240, "zIndex": 3,
          "shape": "rect",
          "fill": "#334155",
          "stroke": { "color": "#94a3b8", "width": 2 },
          "cornerRadius": 24
        },
        {
          "id": "el_marker2",
          "type": "shape",
          "name": "标记点（跨步骤移动并变色）",
          "x": 1000, "y": 560, "width": 80, "height": 80, "zIndex": 5,
          "shape": "ellipse",
          "fill": "#22c55e",
          "stroke": null
        },
        {
          "id": "el_caption2",
          "type": "text",
          "name": "说明文字",
          "x": 200, "y": 700, "width": 1520, "height": 80, "zIndex": 6,
          "text": "点一下：照片和卡片一起推进；再点：标记点移动并变色；再点：照片变黑白",
          "font": "font_inter", "fontSize": 36, "color": "#e2e8f0"
        }
      ],
      "steps": [
        {
          "id": "step_scene_push1",
          "name": "点击：照片、混合层、两张卡片一起向左平移并缩小",
          "trigger": "click",
          "tracks": [
            { "target": "el_photo2", "duration": 700, "easing": "ease-in-out", "change": { "x": { "by": -120 }, "scale": { "times": 0.85 } } },
            { "target": "el_tint2", "duration": 700, "easing": "ease-in-out", "change": { "x": { "by": -120 }, "scale": { "times": 0.85 } } },
            { "target": "el_card2a", "duration": 700, "easing": "ease-in-out", "change": { "x": { "by": -120 }, "scale": { "times": 0.85 } } },
            { "target": "el_card2b", "duration": 700, "easing": "ease-in-out", "change": { "x": { "by": -120 }, "scale": { "times": 0.85 } } }
          ]
        },
        {
          "id": "step_scene_push2",
          "name": "自动接着：卡片 B 再向上浮起（连续推进的第二段）",
          "trigger": "auto",
          "tracks": [
            { "target": "el_card2b", "duration": 500, "change": { "y": { "by": -60 }, "rotation": { "by": -6 } } },
            { "target": "el_card2a", "delay": 150, "duration": 500, "change": { "y": { "by": -30 } } }
          ]
        },
        {
          "id": "step_scene_marker1",
          "name": "点击：标记点移到卡片 A 下方并变黄",
          "trigger": "click",
          "tracks": [
            { "target": "el_marker2", "duration": 500, "change": { "x": { "by": -120 }, "y": { "by": -80 }, "color": { "to": "#facc15" } } }
          ]
        },
        {
          "id": "step_scene_marker2",
          "name": "点击：标记点再移到卡片 B 下方并变红",
          "trigger": "click",
          "tracks": [
            { "target": "el_marker2", "duration": 500, "change": { "x": { "by": 400 }, "color": { "to": "#ef4444" } } }
          ]
        },
        {
          "id": "step_scene_gray",
          "name": "点击：照片变黑白，混合层淡出",
          "trigger": "click",
          "tracks": [
            { "target": "el_photo2", "duration": 800, "change": { "filters": { "grayscale": { "by": 1 } } } },
            { "target": "el_tint2", "duration": 800, "change": { "disappear": true } }
          ]
        }
      ]
    },

    {
      "id": "page_clip3",
      "name": "3 裁切与分组：多边形裁切 / 分组联动",
      "background": "#fafaf9",
      "elements": [
        {
          "id": "el_clipimg3",
          "type": "image",
          "name": "多边形裁切的照片",
          "x": 160, "y": 160, "width": 800, "height": 600, "zIndex": 1,
          "asset": "asset_city01",
          "fit": "cover",
          "effects": {
            "clip": {
              "type": "polygon",
              "points": [[50, 0], [100, 50], [50, 100], [0, 50]]
            }
          }
        },
        {
          "id": "el_group3",
          "type": "group",
          "name": "右侧说明组",
          "x": 1100, "y": 200, "width": 640, "height": 520, "zIndex": 2,
          "children": [
            {
              "id": "el_gbox3",
              "type": "shape",
              "name": "组背景",
              "x": 0, "y": 0, "width": 640, "height": 520, "zIndex": 0,
              "shape": "rect",
              "fill": "#ffffff",
              "stroke": { "color": "#d6d3d1", "width": 2 },
              "cornerRadius": 32
            },
            {
              "id": "el_gtitle3",
              "type": "text",
              "name": "组标题",
              "x": 40, "y": 40, "width": 560, "height": 80, "zIndex": 1,
              "text": "分组：整体一起动",
              "font": "font_inter", "fontSize": 48, "fontWeight": 600, "color": "#1c1917"
            },
            {
              "id": "el_gtri3",
              "type": "shape",
              "name": "三角形",
              "x": 40, "y": 160, "width": 240, "height": 240, "zIndex": 1,
              "shape": "polygon",
              "fill": "#0ea5e9",
              "stroke": null,
              "points": [[50, 0], [100, 100], [0, 100]]
            },
            {
              "id": "el_gnote3",
              "type": "text",
              "name": "组内说明",
              "x": 320, "y": 160, "width": 280, "height": 240, "zIndex": 1,
              "text": "子元素坐标相对分组左上角。エイ 拖动整组时，子元素一起走。",
              "font": "font_inter", "fontSize": 28, "lineHeight": 1.5, "color": "#44403c"
            }
          ]
        },
        {
          "id": "el_pending3",
          "type": "text",
          "name": "待排版提示",
          "x": 160, "y": 860, "width": 1600, "height": 60, "zIndex": 3,
          "text": "素材 asset_newpic1 标记为待排版：エイ 拖进来了，agent 下一轮把它排进页面。",
          "font": null, "fontSize": 28, "color": "#78716c"
        }
      ],
      "steps": [
        {
          "id": "step_clip_morph",
          "name": "点击：裁切从菱形变成六边形",
          "trigger": "click",
          "tracks": [
            {
              "target": "el_clipimg3",
              "duration": 800,
              "change": {
                "clip": {
                  "to": {
                    "type": "polygon",
                    "points": [[25, 0], [75, 0], [100, 50], [75, 100], [25, 100], [0, 50]]
                  }
                }
              }
            }
          ]
        },
        {
          "id": "step_clip_group",
          "name": "点击：整组向左靠拢并放大一点",
          "trigger": "click",
          "tracks": [
            { "target": "el_group3", "duration": 600, "change": { "x": { "by": -80 }, "scale": { "times": 1.05 } } },
            { "target": "el_gtri3", "delay": 300, "duration": 600, "change": { "rotation": { "by": 180 } } }
          ]
        }
      ]
    }
  ]
}
